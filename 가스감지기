# GPIO 17번 핀에 연결된 가스 센서(디지털 출력형)를 'gas'라는 이름으로 선언
gas = DigitalInputDevice(17)

try:
    # 2. 실시간 감지 루프 (프로그램이 실행되는 동안 무한 반복)
    while True:
        # 센서의 값(gas.value)이 0이면 가스가 감지된 상태
        # (대부분의 MQ-2 센서는 가스 검출 시 LOW(0) 신호를 보냄.)
        if gas.value == 0:
            print("가스 감지됨") #출력
            bz.on()                  # 부저를 울림.
        
        # 가스가 감지되지 않은 정상 상태일 때 (gas.value가 1일 때)
        else:
            print("정상")     # 출력
            bz.off()            # 부저를 끔.

        # 0.2초 동안 대기 후 다시 센서 값을 확인 (CPU 과부하 방지)
        time.sleep(0.2)

except KeyboardInterrupt:
    # 3. 프로그램 종료 처리
    # 사용자가 'Ctrl + C'를 눌러 프로그램을 강제로 멈출 때 실행
    pass

# 프로그램이 완전히 종료되기 전에 부저가 계속 울리지 않도록 안전하게 끈다
bz.off()
