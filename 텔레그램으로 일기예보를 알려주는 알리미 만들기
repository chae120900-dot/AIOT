import urllib.request  # 웹 페이지 데이터를 가져오는 도구
import json            # 복잡한 데이터를 정리된 사전 형태로 변환
from datetime import datetime  # 현재 날짜와 시간을 확인
import asyncio         # 비동기(시간 대기 등) 처리를 위한 라이브러리
from telegram import Bot  # 텔레그램 메시지 전송 기능

# 접속 정보 설정
telegram_id = '내_ID'     # 내 텔레그램 숫자 ID
my_token = '봇_토큰'      # 봇 관리자에게 받은 토큰
api_key = '날씨_키'       # 날씨 사이트 발급 키

bot = Bot(token=my_token)  # 봇 객체 생성

# 알림 시간 설정
ALERT_HOURS = [7, 10, 13, 16, 19, 22]  # 매 3시간 간격 정각 알림
ALERT_TIMES = ["08:30", "14:45"]       # 특정 시분 지정 알림

def getWeather():
    # 날씨 데이터를 가져올 주소 설정 (서울 기준)
    url = f"https://api.openweathermap.org/data/2.5/forecast?q=Seoul&appid={api_key}&units=metric&lang=kr&cnt=8"
    
    with urllib.request.urlopen(url) as r:
        data = json.loads(r.read())  # 서버 응답을 JSON으로 변환
    
    text = ""
    for i in range(8):  # 3시간 간격, 총 24시간 예보 반복
        item = data['list'][i]
        hour = str((int(item['dt_txt'][11:13]) + 9) % 24).zfill(2) # KST 시간 보정
        temp = item['main']['temp']      # 온도 추출
        humi = item['main']['humidity']  # 습도 추출
        desc = item['weather'][0]['description'] # 날씨 설명 추출
        text += f"{hour}시 {temp}도 {humi}% {desc}\n" # 결과 문장 조립
        
    return text  # 완성된 날씨 문자열 반환

async def main():
    try:
        while True:  # 무한 반복
            now = datetime.now()  # 현재 시간 가져오기
            hm = now.strftime('%H:%M') # "08:30" 같은 형식으로 변환
            
            # 정각 알림 조건 확인 (시각 일치, 0분 0초)
            is_alert_hour = now.hour in ALERT_HOURS and now.minute == 0 and now.second == 0
            # 지정 시간 알림 조건 확인 (시분 일치, 0초)
            is_alert_time = hm in ALERT_TIMES and now.second == 0
            
            if is_alert_hour or is_alert_time:
                msg = getWeather()  # 날씨 정보 생성
                print(msg)          # 터미널에 출력
                await bot.send_message(chat_id=telegram_id, text=msg) # 텔레그램 전송
                
            await asyncio.sleep(1)  # 1초 대기 후 다시 확인
            
    except KeyboardInterrupt:  # Ctrl+C 누르면 종료
        pass

asyncio.run(main())  # 메인 함수 실행
