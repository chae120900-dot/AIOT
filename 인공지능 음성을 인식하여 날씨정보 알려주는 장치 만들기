import speech_recognition as sr  # 구글 음성 인식 라이브러리 임포트

try:
    while True:  # 사용자가 강제 종료(Ctrl+C)할 때까지 무한 반복 실행
        r = sr.Recognizer()  # 음성 인식을 처리할 전용 객체 생성
        
        # 마이크 센서를 음성 입력 소스로 설정
        with sr.Microphone() as source:  
            print("Say something!")  # 사용자에게 음성 입력 시작을 알림
            audio = r.listen(source)  # 마이크로 들어온 음성을 녹음하여 데이터로 저장
            
        try:
            # 구글 API를 사용해 녹음된 한국어 음성을 텍스트(문자열)로 변환
            text = r.recognize_google(audio, language='ko-KR')  
            print("You said: " + text)  # 변환 완료된 텍스트 화면 출력
            
            # 인식된 단어에 "날씨"라는 키워드가 포함되어 있는지 검사
            if "날씨" in text:  
                print("날씨 음성을 인식하였습니다.")  # 조건 만족 시 성공 메시지 출력
                
        # 음성은 감지했으나 무슨 말인지 명확히 파악하지 못한 경우 처리
        except sr.UnknownValueError:  
            print("Google Speech Recognition could not understand audio")  
            
        # 구글 API 서버 요청 자체가 실패했거나 네트워크 연결 오류 시 처리
        except sr.RequestError as e:  
            print("Could not request results from Google Speech Recognition service; {0}".format(e))  

# 사용자가 터미널에서 Ctrl+C를 입력하여 프로그램을 수동 종료할 때 실행
except KeyboardInterrupt:  
    pass  # 추가 처리 없이 안전하게 무한 루프 탈출 및 프로그램 종료
