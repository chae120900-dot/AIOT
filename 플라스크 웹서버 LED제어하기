from flask import Flask                            # 웹서버 구축, HTML 템플릿 렌더링, 요청 데이터 처리를 위한 Flask 모듈 임포트
from gpiozero import LED                           # 라즈베리파이 GPIO 핀을 쉽게 제어하기 위한 gpiozero 라이브러리의 LED 클래스 임포트

app = Flask(__name__)                              # Flask 애플리케이션 객체를 생성하고 현재 모듈의 이름을 전달

red_led = LED(21)                                  # GPIO 21번 핀에 연결된 빨간색 LED 객체를 생성 (회로도의 GPIO 21번과 일치)

@app.route('/')                                    # 브라우저에서 기본 주소('/')로 접속했을 때 실행될 경로(Route) 설정
def home():                                        # 기본 주소 접속 시 실행되는 함수
    return render_template("index.html")           # templates 폴더 안에 있는 "index.html" 파일을 읽어서 웹 브라우저에 보여줌

@app.route('/data', methods=['POST'])              # '/data' 주소로 POST 방식의 요청(버튼 클릭 등)이 왔을 때 실행될 경로 설정
def data():                                        # 데이터 처리를 위한 함수
    data = request.form['led']                     # HTML 폼(Form)에서 전송된 'led'라는 이름의 데이터 값을 가져옴
    
    if data == 'on':                               # 만약 가져온 데이터 값이 'on'이라면
        red_led.on()                               # GPIO 21번에 연결된 LED를 켬
        
    elif data == 'off':                            # 만약 가져온 데이터 값이 'off'라면
        red_led.off()                              # GPIO 21번에 연결된 LED를 끔
        
    return home()                                  # 처리가 완료된 후 다시 메인 페이지(home)로 돌아가 화면을 갱신

if __name__ == "__main__":                         # 이 스크립트가 직접 실행될 때만 아래 코드를 실행
    app.run(host="0.0.0.0", port="80")             # 모든 네트워크 인터페이스(0.0.0.0)에서 80번 포트로 웹 서버를 가동
